# ==========================================
# Kit Culture .gitignore
# ==========================================

# Python / Django artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database & SQLite files
*.sqlite3
db.sqlite3
db.sqlite3-journal

# Media & uploaded assets (keep directory structure with .gitkeep)
backend/media/jerseys/*
!backend/media/jerseys/.gitkeep
backend/staticfiles/

# Python Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env

# Node.js & React Frontend
node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# IDE & Editor settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace

# Operating System temporary files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Temporary test files
test.txt
*.tmp
*.bak
